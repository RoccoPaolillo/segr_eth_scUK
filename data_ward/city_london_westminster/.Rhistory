recode_01 <- recode_01[-1,]
r_df01 <- as.data.frame(t(recode_01))
names(r_df01) <- r_df01[1,]
r_df01 <- r_df01[-1,]
df_all01_r <- rbind(r_df01,df_all01)
check_dfall01 <- t(df_all01_r[1,])
names(df_all01_r) <- df_all01_r[1,]
df_all01_r <- df_all01_r[-1,]
